{
  "name": "chemical-groups-editor",
  "private": true,
  "version": "0.0.0",
  "description": "Editor for the chemical groups of cheminfo/mass-tools",
  "author": "Luc Patiny",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check-types": "tsc --noEmit",
    "dev": "vite",
    "eslint": "eslint .",
    "eslint-fix": "eslint . --fix",
    "prettier": "prettier --check .",
    "prettier-write": "prettier --write .",
    "test": "npm run test-only && npm run check-types && npm run eslint && npm run prettier",
    "test-only": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheminfo/chemical-groups-editor.git"
  },
  "bugs": {
    "url": "https://github.com/cheminfo/chemical-groups-editor/issues"
  },
  "homepage": "https://github.com/cheminfo/chemical-groups-editor#readme",
  "dependencies": {
    "@blueprintjs/core": "^6.18.0",
    "@blueprintjs/icons": "^6.13.0",
    "@codemirror/lang-json": "^6.0.2",
    "@uiw/react-codemirror": "^4.25.11",
    "mf-parser": "^3.9.2",
    "openchemlib": "^9.25.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-mf": "^3.1.1",
    "react-ocl": "^8.7.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@zakodium/tsconfig": "^1.0.5",
    "eslint": "^9.39.5",
    "eslint-config-cheminfo-react": "^20.1.0",
    "eslint-config-cheminfo-typescript": "^22.1.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
